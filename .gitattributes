# Forzar line endings a LF (compatible con Linux, Vercel, etc.)
* text=auto eol=lf

# Archivos comunes del ecosistema
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
